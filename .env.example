# Copy to .env and fill in real values. Never commit .env — see .gitignore.

# --- Supabase (required) ---
# Public — safe to expose to the browser (VITE_ prefix ships in the client bundle).
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
# SERVER ONLY — bypasses RLS. Never prefix with VITE_/NEXT_PUBLIC_, never ship to client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Admin access (required) ---
# Comma/semicolon-separated allowlist of emails permitted into /admin.
ADMIN_EMAILS="you@example.com"

# --- WordPress connector & Webhooks ---
LOVABLE_API_KEY=""
WORDPRESS_API_KEY=""
WORDPRESS_WEBHOOK_SECRET="generate-with-openssl-rand-hex-32"

# --- WooCommerce REST API (primary e-commerce backend — produkty/objednávky/zákazníci) ---
# Direct REST connection to https://{store}/wp-json/wc/v3/ — https:// URL, no path/query.
WOOCOMMERCE_STORE_URL="https://your-shop.example.com"
# WooCommerce → Settings → Advanced → REST API → Add key (Read permission is enough).
WOOCOMMERCE_CONSUMER_KEY=""
WOOCOMMERCE_CONSUMER_SECRET=""

# --- WordPress MySQL Database ---
WP_DB_HOST="db.r1.websupport.sk"
WP_DB_PORT="3306"
WP_DB_NAME="8RJ89UpxAbjaP4mR"
WP_DB_USER="5GckMhNYkGYDr2JK"
