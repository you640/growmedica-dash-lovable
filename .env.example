# Public (safe for browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never prefix with VITE_
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=you@example.com

# WordPress connector (Lovable gateway)
LOVABLE_API_KEY=
WORDPRESS_API_KEY=

# Storefront BFF bridge (GrowMedica Next /api/dashboard/*)
# Local mock: http://localhost:5555 + secret from storefront AGENTS.md
STOREFRONT_BFF_BASE_URL=http://localhost:5555
DASHBOARD_AGENT_SECRET=local-dashboard-agent-secret-min-16-chars
