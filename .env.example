# Copy to .env and fill in real values. Never commit .env — see .gitignore.

# --- Supabase (required) ---
# Public — safe to expose to the browser (VITE_ prefix ships in the client bundle).
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
# SERVER ONLY — bypasses RLS. Never prefix with VITE_/NEXT_PUBLIC_, never ship to client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Admin access (required) ---
# Comma/semicolon-separated allowlist of emails permitted into /admin.
ADMIN_EMAILS="you@example.com"

# --- Shopify Admin API (required for produkty/objednávky/zákazníci pages) ---
# Bare *.myshopify.com hostname — no protocol, path, or port.
SHOPIFY_STORE_DOMAIN="your-shop.myshopify.com"
SHOPIFY_API_VERSION="2026-07"
# Preferred: client-credentials auth (set both together).
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# Legacy fallback: a static Admin API access token (used only if CLIENT_ID/SECRET are unset).
SHOPIFY_ADMIN_ACCESS_TOKEN=""
# HMAC secret for verifying inbound Shopify webhooks.
SHOPIFY_WEBHOOK_SECRET=""

# --- WordPress connector (optional — powers the WordPress card in Nastavenia) ---
LOVABLE_API_KEY=""
WORDPRESS_API_KEY=""
